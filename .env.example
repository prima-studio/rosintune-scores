# App Store Connect API key (Users and Access -> Integrations -> App Store Connect API).
# Copy to .env (gitignored) and fill in. Used by scripts/create_app_store_iaps.py.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# Optional: set either of these to omit --app-id / --bundle-id on the command line.
# ASC_BUNDLE_ID=rosintune.app.primastudio
# ASC_APP_ID=6759510259